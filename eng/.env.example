# ============================================================
# Project Preventia — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
#
# Note: POSTGRES_USER and POSTGRES_DB are hardcoded in
# docker-compose.yml (preventia_dev / preventia_db) and do not
# need to be set here.
# ============================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=

# --- JWT ---
# Must be at least 32 bytes for HS256 signing.
JWT_SECRET=
JWT_EXPIRY_SECONDS=86400

# --- Logging (optional, defaults to INFO) ---
LOG_LEVEL=INFO

# --- Daily.co (video calls — use STUB for local dev) ---
DAILY_API_KEY=STUB
DAILY_WEBHOOK_SECRET=STUB

# --- AWS (use STUB for local dev; S3 uploads will fail gracefully) ---
AWS_ACCESS_KEY_ID=STUB
AWS_SECRET_ACCESS_KEY=STUB
AWS_REGION=ap-south-1
S3_BUCKET_NAME=preventia-mvp-prescriptions

# --- Stripe (NRI sponsor payments — USD) ---
STRIPE_API_KEY=STUB

# --- Razorpay (India payments — INR) ---
RAZORPAY_API_KEY=STUB
RAZORPAY_API_SECRET=STUB

# --- Stream Chat (Patient↔Doctor + Patient↔Pharmacy messaging) ---
# Get free credentials at https://getstream.io → create app "preventia-mvp"
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# --- Firebase (push notifications via FCM — SPRINT-04) ---
# 1. Go to console.firebase.google.com → Project Settings → Service accounts
# 2. Click "Generate new private key" → save the downloaded JSON to:
#    eng/src/main/resources/firebase-credentials.json  (gitignored)
# 3. Set this var to: classpath:firebase-credentials.json
# Leave as classpath:firebase-stub.json for local dev without real push
FIREBASE_CREDENTIALS_PATH=classpath:firebase-stub.json

# ── Email (JavaMailSender — SPRINT-08) ─────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password   # Gmail → Security → App Passwords
MAIL_FROM=noreply@preventia.ai
ADMIN_EMAIL=admin@preventia.ai
MAIL_ENABLED=false                # flip to true once credentials set

# ── Firebase / FCM (SPRINT-08) ──────────────────────────
FIREBASE_ENABLED=false            # flip to true after adding credentials JSON
FIREBASE_CREDENTIALS_PATH=classpath:firebase-credentials.json

# ── Stream Webhooks (SPRINT-09) ─────────────────────────
STREAM_WEBHOOK_SECRET=your_stream_webhook_secret
