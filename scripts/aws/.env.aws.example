# =============================================================================
# .env.aws — Values needed for AWS infrastructure setup
# Copy to .env.aws, fill in all values, then:
#   source .env.aws && ./04-setup-secrets.sh
#
# NEVER commit this file. It's in .gitignore.
# =============================================================================

# --- RDS (filled in after running 02-setup-rds.sh) ---
RDS_HOST=preventia-postgres.xxxx.ap-south-1.rds.amazonaws.com
POSTGRES_PASSWORD=<strong-password-min-16-chars>
DB_NAME=preventia_db
DB_USER=preventia_admin

# --- ElastiCache (filled in after running 03-setup-elasticache.sh) ---
REDIS_HOST=preventia-redis.xxxx.cfg.apse1.cache.amazonaws.com

# --- JWT ---
# Must be at least 32 bytes for HS256 signing.
JWT_SECRET=<same-value-as-local-env>

# --- Daily.co ---
DAILY_API_KEY=<from-dashboard.daily.co>
DAILY_WEBHOOK_SECRET=STUB

# --- Stream Chat ---
STREAM_API_KEY=<from-getstream.io>
STREAM_API_SECRET=<from-getstream.io>

# --- AWS credentials for the app (S3, etc.) ---
# Run ./03a-setup-storage-iam.sh to create these automatically, or fill them manually.
AWS_ACCESS_KEY_ID_APP=
AWS_SECRET_ACCESS_KEY_APP=
S3_BUCKET_NAME=preventia-mvp-prescriptions

# --- Social auth (public client identifiers used by both API and web) ---
GOOGLE_CLIENT_ID=<google-web-client-id>
APPLE_CLIENT_ID=<apple-services-id>
APPLE_REDIRECT_URI=<https://your-web-domain-or-callback>

# --- Razorpay (leave as STUB until payment is ready) ---
RAZORPAY_API_KEY=STUB
RAZORPAY_API_SECRET=STUB
RAZORPAY_WEBHOOK_SECRET=STUB
