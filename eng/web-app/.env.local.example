# Spring Boot backend (must be accessible from the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Set to your Daily.co domain (e.g. your-domain.daily.co)
NEXT_PUBLIC_DAILY_DOMAIN=

# Social auth client IDs
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Apple Sign in with Apple JS requires a registered redirect URL.
# In production, use your HTTPS web origin or callback URL registered in Apple Developer.
APPLE_REDIRECT_URI=
